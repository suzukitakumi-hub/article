# ===========================================================
#  .env.example  -  設定ファイルのテンプレート
#
#  このファイルをコピーして ".env" という名前で保存し、
#  各項目を入力してください。
#
#  ⚠ .env ファイルは Git にコミットしないでください
#     （.gitignore に追加することを推奨）
# ===========================================================

# ---------------------
#  WordPress 接続設定
# ---------------------

# WP サイトの URL（末尾スラッシュ不要）
WP_URL=https://gaikoku-jinzai.tcj-education.com

# WP 管理者ユーザー名
WP_USER=your_wp_username

# WP アプリケーションパスワード
# 取得方法:
#   1. WP 管理画面 → 「ユーザー」→「プロフィール」を開く
#   2. ページ下部「アプリケーションパスワード」セクション
#   3. 名前欄に「Claude Code」と入力 → 「新しいアプリケーションパスワードを追加」
#   4. 表示されたパスワード（スペース区切り）をそのまま貼り付ける
#   ※ このパスワードは作成時の1回しか表示されません
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
