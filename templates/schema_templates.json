      "action": "表示名を「TCJ編集部」などに変更"
    },
    "step5_wordCount_fix": {
      "title": "wordCount問題の修正",
      "priority": "即時実装",
      "method": "Yoast SEOプラグインの更新または設定確認",
      "action": "Yoast SEOを最新版に更新。問題が続く場合はサポートに問い合わせ"
    }
  },
